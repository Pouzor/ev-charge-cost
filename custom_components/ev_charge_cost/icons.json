{
  "entity": {
    "binary_sensor": {
      "charging": {
        "default": "mdi:ev-station",
        "state": {
          "on": "mdi:battery-charging"
        }
      }
    },
    "calendar": {
      "history": {
        "default": "mdi:history"
      }
    },
    "sensor": {
      "session_duration": {
        "default": "mdi:timer-outline"
      },
      "last_session_duration": {
        "default": "mdi:timer-outline"
      },
      "total_cost": {
        "default": "mdi:cash-multiple"
      },
      "session_count": {
        "default": "mdi:counter"
      },
      "current_price": {
        "default": "mdi:cash-clock"
      },
      "last_session_consumption": {
        "default": "mdi:car-electric-outline"
      },
      "last_session_cost_per_100km": {
        "default": "mdi:cash-fast"
      }
    }
  },
  "services": {
    "stop_session": {
      "service": "mdi:stop-circle-outline"
    },
    "reset_totals": {
      "service": "mdi:restore"
    }
  }
}
